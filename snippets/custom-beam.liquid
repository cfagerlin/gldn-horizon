{% comment %}
  custom-beam.liquid
  Beam Impact integration — port of legacy beam-imports.liquid + beam-config.liquid + beam-cart-setup.liquid.
  Rendered before </body> via layout/theme.liquid.
  Controlled by theme settings: beam_sdk_version, beam_api_key, beam_chain_id, beam_store_id, beam_store_domain, beam_base_url.
{% endcomment %}

{%- if settings.beam_api_key != blank and settings.beam_sdk_version != blank -%}
  {%- assign beam_base = 'https://sdk.beamimpact.com/web-sdk/' | append: settings.beam_sdk_version | append: '/dist' -%}

  {% comment %} Initialize Beam SDK {% endcomment %}
  <script type="module">
    import { init } from "{{ beam_base }}/integrations/beam.js";

    const beam = await init({
      apiKey: "{{ settings.beam_api_key }}",
      chainId: {{ settings.beam_chain_id }},
      storeId: {{ settings.beam_store_id }},
      domain: window.location.hostname || "{{ settings.beam_store_domain }}",
      plugins: []
    });
  </script>

  {% comment %} Cart integration {% endcomment %}
  <script type="module" async crossorigin>
    import { registerCartIntegration } from "{{ beam_base }}/integrations/shopify.js";

    registerCartIntegration({
      apiKey: "{{ settings.beam_api_key }}",
      storeId: {{ settings.beam_store_id }},
      baseUrl: "{{ settings.beam_base_url }}",
      domain: "{{ settings.beam_store_domain }}" || undefined,
    });
  </script>

  {% comment %} Nonprofit selector web component {% endcomment %}
  {% comment %}theme-check-disable RemoteAsset{% endcomment %}
  <script
    type="module"
    async
    crossorigin
    data-em-disable
    data-categories="analytics"
    src="{{ beam_base }}/components/select-nonprofit.js"
  ></script>
{%- endif -%}
