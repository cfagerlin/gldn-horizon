{% comment %}
  sections/custom-footer-trust-bar.liquid
  GLDN — Trust signals bar rendered above the two-tone footer.

  Three configurable blocks: icon (inline SVG) + heading + optional description.
  Default content: Happiness Guarantee · Gift-Ready Boxes · Complementary Shipping.
  Enabled on footer group; sits as nth-child(1) and spans full width via custom.css grid.
{% endcomment %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="gldn-trust-bar section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="--trust-bar-padding: {{ section.settings.padding_vertical }}px;"
>
  <ul class="gldn-trust-bar__list" role="list">
    {%- for block in section.blocks -%}
      <li class="gldn-trust-bar__item" {{ block.shopify_attributes }}>
        {%- unless block.settings.icon == 'none' or block.settings.icon == blank -%}
          <span class="gldn-trust-bar__icon" aria-hidden="true">
            {{- block.settings.icon | inline_asset_content -}}
          </span>
        {%- endunless -%}
        <div class="gldn-trust-bar__text">
          {%- if block.settings.heading != blank -%}
            <span class="gldn-trust-bar__heading">{{ block.settings.heading | escape }}</span>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <span class="gldn-trust-bar__description">{{ block.settings.description | escape }}</span>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .gldn-trust-bar {
    padding-block: var(--trust-bar-padding, 24px);
  }

  .gldn-trust-bar__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 1.5em 3em;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .gldn-trust-bar__item {
    display: flex;
    align-items: center;
    gap: 0.75em;
    text-align: left;
  }

  .gldn-trust-bar__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    width: 2.25em;
    height: 2.25em;
  }

  .gldn-trust-bar__icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
    stroke: currentColor;
  }

  .gldn-trust-bar__text {
    display: flex;
    flex-direction: column;
    gap: 0.1em;
  }

  .gldn-trust-bar__heading {
    font-weight: 500;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.3;
  }

  .gldn-trust-bar__description {
    font-size: 0.8125rem;
    opacity: 0.8;
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .gldn-trust-bar__list {
      flex-direction: column;
      align-items: center;
      gap: 1.25em;
    }

    .gldn-trust-bar__item {
      text-align: center;
      flex-direction: column;
      align-items: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GLDN Trust Bar",
  "class": "section-wrapper",
  "enabled_on": { "groups": ["footer"] },
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Happiness Guarantee"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "SVG icon filename (assets/)",
          "info": "Filename without extension, e.g. icon-heart. Leave blank for no icon.",
          "default": "icon-heart"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "GLDN Trust Bar",
      "blocks": {
        "trust_1": {
          "type": "trust_item",
          "settings": {
            "heading": "Happiness Guarantee",
            "description": "Love it or we'll make it right.",
            "icon": "icon-heart"
          }
        },
        "trust_2": {
          "type": "trust_item",
          "settings": {
            "heading": "Gift-Ready Boxes",
            "description": "Every order arrives beautifully packaged.",
            "icon": "icon-gift"
          }
        },
        "trust_3": {
          "type": "trust_item",
          "settings": {
            "heading": "Complementary Shipping",
            "description": "Free shipping on US orders.",
            "icon": "icon-delivery"
          }
        }
      },
      "block_order": ["trust_1", "trust_2", "trust_3"]
    }
  ]
}
{% endschema %}
