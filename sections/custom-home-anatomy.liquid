{% comment %}
  sections/custom-home-anatomy.liquid
  GLDN — Home Anatomy / Product Feature Carousel

  Fade carousel: each slide has product image (right) + feature
  specs grid alongside eyebrow/title/text/CTA (left).
  Native web component — no jQuery, no Slick.
  Maps from legacy: sections/home_anatomy.liquid
{% endcomment %}

{%- assign section_id = 'custom-home-anatomy-' | append: section.id -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style custom-home-anatomy"
  id="{{ section_id }}"
  aria-label="{{ section.settings.heading | default: 'Product features' | escape }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if section.settings.heading != blank -%}
    <div class="custom-home-anatomy__head">
      <h2 class="custom-home-anatomy__heading">{{ section.settings.heading | escape }}</h2>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <gldn-fade-carousel
      class="custom-home-anatomy__carousel"
      {% if section.settings.autoplay %}
        autoplay="{{ section.settings.autoplay_speed | times: 1000 }}"
      {% endif %}
      aria-roledescription="carousel"
    >
      <div class="custom-home-anatomy__slides" aria-live="polite" aria-atomic="false">
        {%- for block in section.blocks -%}
          <div
            class="custom-home-anatomy__slide{% if forloop.first %} is-active{% endif %}"
            role="group"
            aria-roledescription="slide"
            aria-label="{{ forloop.index }} of {{ section.blocks.size }}"
            aria-hidden="{{ forloop.first | default: false | json | replace: 'true', 'false' | replace: 'false', 'true' }}"
            {% unless forloop.first %}aria-hidden="true"{% endunless %}
            {{ block.shopify_attributes }}
          >
            <div class="custom-home-anatomy__slide-inner">
              <div class="custom-home-anatomy__text-col">
                {%- if block.settings.eyebrow != blank -%}
                  <p class="custom-home-anatomy__eyebrow">{{ block.settings.eyebrow | escape }}</p>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="custom-home-anatomy__title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="custom-home-anatomy__body rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                  <a class="custom-home-anatomy__cta" href="{{ block.settings.button_link }}">
                    {{ block.settings.button_label | escape }}
                  </a>
                {%- endif -%}
              </div>

              <div class="custom-home-anatomy__media-col">
                <div class="custom-home-anatomy__img-wrap">
                  <div class="custom-home-anatomy__img-main">
                    {%- if block.settings.image != blank -%}
                      {%- assign block_image_alt = block.settings.title | default: '' | escape -%}
                      {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 600, 900', sizes: '(min-width: 750px) 35vw, 67vw', alt: block_image_alt, class: 'custom-home-anatomy__image' }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'custom-home-anatomy__image custom-home-anatomy__placeholder' }}
                    {%- endif -%}
                  </div>

                  {%- if block.settings.features != blank -%}
                    <div class="custom-home-anatomy__features rte">{{ block.settings.features }}</div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="custom-home-anatomy__controls" aria-label="{{ 'accessibility.carousel_navigation' | t | default: 'Carousel navigation' }}">
          <button
            class="custom-home-anatomy__arrow custom-home-anatomy__arrow--prev"
            aria-label="{{ 'accessibility.previous_slide' | t | default: 'Previous slide' }}"
            data-carousel-prev
          >
            <svg aria-hidden="true" viewBox="0 0 32 32"><path fill="currentColor" d="M0,16C0,7.178,7.178,0,16,0s16,7.178,16,16s-7.178,16-16,16S0,24.822,0,16z M1.203,16 c0,8.159,6.638,14.797,14.797,14.797S30.797,24.159,30.797,16S24.159,1.203,16,1.203S1.203,7.841,1.203,16z M16.978,21.22 l0.851-0.851l-4.53-4.529l4.53-4.53l-0.851-0.851l-5.38,5.381L16.978,21.22z"/></svg>
          </button>
          <button
            class="custom-home-anatomy__arrow custom-home-anatomy__arrow--next"
            aria-label="{{ 'accessibility.next_slide' | t | default: 'Next slide' }}"
            data-carousel-next
          >
            <svg aria-hidden="true" viewBox="0 0 32 32"><path fill="currentColor" d="M16,32C7.178,32,0,24.822,0,16S7.178,0,16,0s16,7.178,16,16S24.822,32,16,32z M16,1.203 C7.841,1.203,1.203,7.841,1.203,16S7.841,30.797,16,30.797S30.797,24.159,30.797,16S24.159,1.203,16,1.203z M20.402,15.84 l-5.38-5.381l-0.851,0.851l4.53,4.53l-4.53,4.529l0.851,0.851L20.402,15.84z"/></svg>
          </button>
        </div>
      {%- endif -%}
    </gldn-fade-carousel>
  {%- endif -%}
</section>

{% stylesheet %}
  .custom-home-anatomy {
    padding: 5em 0;
  }

  .custom-home-anatomy__head {
    text-align: center;
    margin-block-end: 3em;
  }

  .custom-home-anatomy__heading { margin: 0; }

  .custom-home-anatomy__carousel {
    display: block;
    position: relative;
  }

  .custom-home-anatomy__slides {
    display: grid;
    grid-template-areas: 'stack';
  }

  .custom-home-anatomy__slide {
    grid-area: stack;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s ease;
  }

  .custom-home-anatomy__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .custom-home-anatomy__slide-inner {
    display: grid;
    gap: var(--gap-2xl);
    align-items: center;

    @media screen and (min-width: 750px) {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ---- Left column: text ---- */
  .custom-home-anatomy__text-col {
    display: flex;
    flex-direction: column;
    max-width: 28em;
    padding: 2em 0;
  }

  .custom-home-anatomy__eyebrow {
    margin: 0 0 0.5em;
    font-size: 0.75em;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .custom-home-anatomy__title {
    margin: 0 0 1em;
    font-family: var(--font-heading--family, 'Spectral', Georgia, serif);
    font-size: 2.18em;
    font-weight: 200;
    font-style: normal;
    letter-spacing: -0.02em;
    line-height: 110%;
  }

  /* Body text: heading font, large, light weight — testimonial quotes */
  .custom-home-anatomy__body {
    margin: 0;
    font-family: var(--font-heading--family, 'Spectral', Georgia, serif);
    font-size: 1.375em;
    font-weight: 200;
    line-height: 130%;
    min-height: 9em;
  }

  .custom-home-anatomy__body p {
    margin-bottom: 0.5em;
  }

  .custom-home-anatomy__body a {
    font-family: var(--font-body--family, 'freight-sans-pro', sans-serif);
    font-size: 0.545454em;
    letter-spacing: 0.1em;
    font-weight: 300;
    text-transform: uppercase;
    text-decoration: underline;
    color: inherit !important;
  }

  /* CTA button — btn v2 style: light bg, dark text */
  .custom-home-anatomy__cta {
    align-self: flex-start;
    display: inline-block;
    margin-top: 1em;
    font-family: var(--font-body--family, 'freight-sans-pro', sans-serif);
    font-size: 0.75em;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    padding: 1.17em 2em;
    border: 0;
    border-radius: 0;
    color: #333;
    background-color: #fdfdfd;
    min-width: 240px;
    text-align: center;
    line-height: 100%;
  }

  /* ---- Right column: image + features ---- */
  .custom-home-anatomy__media-col {
    position: relative;
    padding-right: 1.5em;
    padding-bottom: 3em;
  }

  .custom-home-anatomy__img-wrap {
    position: relative;
    display: grid;
    grid-template-columns: 71% 29%;
    align-items: end;
  }

  /* Decorative border behind image — matches live site */
  .custom-home-anatomy__img-wrap::before {
    content: '';
    position: absolute;
    bottom: -3em;
    right: -1.5em;
    width: 75%;
    height: 100%;
    border: 1px solid currentColor;
    pointer-events: none;
  }

  .custom-home-anatomy__image,
  .custom-home-anatomy__placeholder {
    width: 100%;
    aspect-ratio: 100 / 137;
    object-fit: cover;
    display: block;
    position: relative;
  }

  .custom-home-anatomy__features {
    padding: 1em 0 1em 2em;
    font-size: 0.875rem;
    line-height: 140%;
  }

  .custom-home-anatomy__features p {
    line-height: 140%;
  }

  .custom-home-anatomy__features strong {
    font-weight: 400;
    text-transform: uppercase;
    font-size: 0.625em;
    letter-spacing: 0.1em;
  }

  .custom-home-anatomy__features a {
    color: inherit !important;
    text-decoration: underline;
  }

  @media (hover: hover) {
    .custom-home-anatomy__features a:hover {
      opacity: 0.7;
    }
  }

  /* ---- Controls: left-aligned arrows, below carousel ---- */
  .custom-home-anatomy__controls {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.4em;
    margin-block-start: 1em;
  }

  .custom-home-anatomy__arrow {
    background: none;
    border: 0;
    padding: 0;
    font-size: 2.1875em;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 0.2s ease;
    color: inherit;
  }

  .custom-home-anatomy__arrow:hover {
    opacity: 1;
  }

  .custom-home-anatomy__arrow svg {
    width: 1em;
    height: 1em;
    display: block;
  }

  .custom-home-anatomy__counter {
    font-size: 0.875rem;
    min-width: 3ch;
    text-align: center;
    display: none;
  }

  /* ---- Responsive ---- */

  @media screen and (max-width: 749px) {
    .custom-home-anatomy {
      padding: 3.5em 1.5rem 2.5em;
    }

    .custom-home-anatomy__slide-inner {
      grid-template-columns: 1fr;
    }

    .custom-home-anatomy__text-col {
      max-width: none;
      padding: 0;
    }

    .custom-home-anatomy__media-col {
      padding-right: 0;
      padding-bottom: 0;
    }

    .custom-home-anatomy__img-wrap {
      grid-template-columns: 67% 33%;
    }

    .custom-home-anatomy__img-wrap::before {
      display: none;
    }

    .custom-home-anatomy__image {
      aspect-ratio: auto;
      height: 100%;
    }

    .custom-home-anatomy__features {
      padding: 1em 0.5em 1em 1em;
      min-height: 16em;
    }

    .custom-home-anatomy__eyebrow {
      font-size: 0.6875em;
    }

    .custom-home-anatomy__title {
      font-size: 1.875em;
      margin-bottom: 0.5em;
    }

    .custom-home-anatomy__body {
      font-size: 1.1875em;
      min-height: 9em;
    }

    .custom-home-anatomy__cta {
      width: 100%;
      margin-top: 2em;
    }

    .custom-home-anatomy__controls {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .custom-home-anatomy__slide { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('gldn-fade-carousel')) {
    class GldnFadeCarousel extends HTMLElement {
      #current = 0;
      #slides = [];
      #timer = null;

      connectedCallback() {
        this.#slides = Array.from(this.querySelectorAll('.custom-home-anatomy__slide'));

        this.querySelector('[data-carousel-prev]')?.addEventListener('click', () => this.#go(-1));
        this.querySelector('[data-carousel-next]')?.addEventListener('click', () => this.#go(1));

        this.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') this.#go(-1);
          if (e.key === 'ArrowRight') this.#go(1);
        });

        const autoplayMs = parseInt(this.getAttribute('autoplay'), 10);
        if (autoplayMs > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          this.#startAutoplay(autoplayMs);
        }

        this.#updateCounter();
      }

      disconnectedCallback() {
        clearInterval(this.#timer);
      }

      #go(direction) {
        const next = (this.#current + direction + this.#slides.length) % this.#slides.length;
        this.#activate(next);
      }

      #activate(index) {
        this.#slides[this.#current].classList.remove('is-active');
        this.#slides[this.#current].setAttribute('aria-hidden', 'true');

        this.#current = index;
        this.#slides[this.#current].classList.add('is-active');
        this.#slides[this.#current].removeAttribute('aria-hidden');

        this.#updateCounter();
      }

      #updateCounter() {
        const el = this.querySelector('[data-carousel-current]');
        if (el) el.textContent = this.#current + 1;
      }

      #startAutoplay(ms) {
        this.#timer = setInterval(() => this.#go(1), ms);
        this.addEventListener('mouseenter', () => clearInterval(this.#timer), { once: false });
        this.addEventListener('mouseleave', () => { this.#timer = setInterval(() => this.#go(1), ms); }, { once: false });
      }
    }

    customElements.define('gldn-fade-carousel', GldnFadeCarousel);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Home Anatomy",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": false },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds per slide",
      "min": 3, "max": 9, "step": 1, "unit": "s",
      "default": 5,
      "info": "Only active when auto-rotate is enabled"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Body text" },
        { "type": "image_picker", "id": "image", "label": "Product image" },
        { "type": "richtext", "id": "features", "label": "Features / specs", "info": "HTML list of product details shown beside the image" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Anatomy",
      "category": "Promotional",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
