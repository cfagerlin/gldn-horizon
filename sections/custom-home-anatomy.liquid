{% comment %}
  sections/custom-home-anatomy.liquid
  GLDN — Home Anatomy / Product Feature Carousel

  Fade carousel: each slide has product image (right) + feature
  specs grid alongside eyebrow/title/text/CTA (left).
  Native web component — no jQuery, no Slick.
  Maps from legacy: sections/home_anatomy.liquid
{% endcomment %}

{%- assign section_id = 'custom-home-anatomy-' | append: section.id -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style custom-home-anatomy"
  id="{{ section_id }}"
  aria-label="{{ section.settings.heading | default: 'Product features' | escape }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if section.settings.heading != blank -%}
    <div class="custom-home-anatomy__head">
      <h2 class="custom-home-anatomy__heading">{{ section.settings.heading | escape }}</h2>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <gldn-fade-carousel
      class="custom-home-anatomy__carousel"
      {% if section.settings.autoplay %}
        autoplay="{{ section.settings.autoplay_speed | times: 1000 }}"
      {% endif %}
      aria-roledescription="carousel"
    >
      <div class="custom-home-anatomy__slides" aria-live="polite" aria-atomic="false">
        {%- for block in section.blocks -%}
          <div
            class="custom-home-anatomy__slide{% if forloop.first %} is-active{% endif %}"
            role="group"
            aria-roledescription="slide"
            aria-label="{{ forloop.index }} of {{ section.blocks.size }}"
            aria-hidden="{{ forloop.first | default: false | json | replace: 'true', 'false' | replace: 'false', 'true' }}"
            {% unless forloop.first %}aria-hidden="true"{% endunless %}
            {{ block.shopify_attributes }}
          >
            <div class="custom-home-anatomy__slide-inner">
              <div class="custom-home-anatomy__text-col">
                {%- if block.settings.eyebrow != blank -%}
                  <p class="custom-home-anatomy__eyebrow">{{ block.settings.eyebrow | escape }}</p>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="custom-home-anatomy__title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="custom-home-anatomy__body rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                  <a class="button button-secondary custom-home-anatomy__cta" href="{{ block.settings.button_link }}">
                    {{ block.settings.button_label | escape }}
                  </a>
                {%- endif -%}
              </div>

              <div class="custom-home-anatomy__media-col">
                {%- if block.settings.image != blank -%}
                  {%- assign block_image_alt = block.settings.title | default: '' | escape -%}
                  {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 600, 900', sizes: '(min-width: 750px) 45vw, 90vw', alt: block_image_alt, class: 'custom-home-anatomy__image' }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'custom-home-anatomy__image custom-home-anatomy__placeholder' }}
                {%- endif -%}

                {%- if block.settings.features != blank -%}
                  <div class="custom-home-anatomy__features rte">{{ block.settings.features }}</div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="custom-home-anatomy__controls" aria-label="{{ 'accessibility.carousel_navigation' | t | default: 'Carousel navigation' }}">
          <button
            class="custom-home-anatomy__arrow custom-home-anatomy__arrow--prev"
            aria-label="{{ 'accessibility.previous_slide' | t | default: 'Previous slide' }}"
            data-carousel-prev
          >
            {{ 'icon-chevron-left.svg' | inline_asset_content }}
          </button>
          <span class="custom-home-anatomy__counter" aria-hidden="true">
            <span data-carousel-current>1</span> / {{ section.blocks.size }}
          </span>
          <button
            class="custom-home-anatomy__arrow custom-home-anatomy__arrow--next"
            aria-label="{{ 'accessibility.next_slide' | t | default: 'Next slide' }}"
            data-carousel-next
          >
            {{ 'icon-chevron-right.svg' | inline_asset_content }}
          </button>
        </div>
      {%- endif -%}
    </gldn-fade-carousel>
  {%- endif -%}
</section>

{% stylesheet %}
  .custom-home-anatomy__head {
    text-align: center;
    margin-block-end: var(--gap-2xl);
  }

  .custom-home-anatomy__heading { margin: 0; }

  .custom-home-anatomy__carousel {
    display: block;
    position: relative;
  }

  .custom-home-anatomy__slides {
    display: grid;
    grid-template-areas: 'stack';
  }

  .custom-home-anatomy__slide {
    grid-area: stack;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .custom-home-anatomy__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .custom-home-anatomy__slide-inner {
    display: grid;
    gap: var(--gap-2xl);
    align-items: center;

    @media screen and (min-width: 750px) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .custom-home-anatomy__text-col {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .custom-home-anatomy__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.65;
  }

  .custom-home-anatomy__title {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .custom-home-anatomy__body { margin: 0; }

  .custom-home-anatomy__cta { align-self: flex-start; }

  .custom-home-anatomy__media-col {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
  }

  .custom-home-anatomy__image,
  .custom-home-anatomy__placeholder {
    width: 100%;
    height: auto;
    display: block;
  }

  .custom-home-anatomy__features {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .custom-home-anatomy__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-md);
    margin-block-start: var(--gap-xl);
  }

  .custom-home-anatomy__arrow {
    background: none;
    border: 1px solid currentColor;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
    padding: 0;
  }

  .custom-home-anatomy__arrow:hover {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .custom-home-anatomy__arrow svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  .custom-home-anatomy__counter {
    font-size: 0.875rem;
    min-width: 3ch;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .custom-home-anatomy__slide { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('gldn-fade-carousel')) {
    class GldnFadeCarousel extends HTMLElement {
      #current = 0;
      #slides = [];
      #timer = null;

      connectedCallback() {
        this.#slides = Array.from(this.querySelectorAll('.custom-home-anatomy__slide'));

        this.querySelector('[data-carousel-prev]')?.addEventListener('click', () => this.#go(-1));
        this.querySelector('[data-carousel-next]')?.addEventListener('click', () => this.#go(1));

        this.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') this.#go(-1);
          if (e.key === 'ArrowRight') this.#go(1);
        });

        const autoplayMs = parseInt(this.getAttribute('autoplay'), 10);
        if (autoplayMs > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          this.#startAutoplay(autoplayMs);
        }

        this.#updateCounter();
      }

      disconnectedCallback() {
        clearInterval(this.#timer);
      }

      #go(direction) {
        const next = (this.#current + direction + this.#slides.length) % this.#slides.length;
        this.#activate(next);
      }

      #activate(index) {
        this.#slides[this.#current].classList.remove('is-active');
        this.#slides[this.#current].setAttribute('aria-hidden', 'true');

        this.#current = index;
        this.#slides[this.#current].classList.add('is-active');
        this.#slides[this.#current].removeAttribute('aria-hidden');

        this.#updateCounter();
      }

      #updateCounter() {
        const el = this.querySelector('[data-carousel-current]');
        if (el) el.textContent = this.#current + 1;
      }

      #startAutoplay(ms) {
        this.#timer = setInterval(() => this.#go(1), ms);
        this.addEventListener('mouseenter', () => clearInterval(this.#timer), { once: false });
        this.addEventListener('mouseleave', () => { this.#timer = setInterval(() => this.#go(1), ms); }, { once: false });
      }
    }

    customElements.define('gldn-fade-carousel', GldnFadeCarousel);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Home Anatomy",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": false },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds per slide",
      "min": 3, "max": 9, "step": 1, "unit": "s",
      "default": 5,
      "info": "Only active when auto-rotate is enabled"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Body text" },
        { "type": "image_picker", "id": "image", "label": "Product image" },
        { "type": "richtext", "id": "features", "label": "Features / specs", "info": "HTML list of product details shown beside the image" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Anatomy",
      "category": "Promotional",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
