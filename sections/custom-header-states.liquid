{% comment %}
  sections/custom-header-states.liquid
  GLDN — Header colour states (normal / hover / scroll)

  PURPOSE
  -------
  Injects CSS custom properties that drive header background and text colour
  for each of the three GLDN header states. The actual state toggling is done
  by assets/custom-header-state.js which sets data-gldn-state on #header-component.

  SETUP (one-time, Theme Editor)
  -----
  1. Theme Editor → Header section group → Add section → "GLDN Header States"
  2. Configure the three colour states.
  3. This section then renders on every page automatically (header group).

  This section renders NO visible HTML — only a <style> block + the JS loader.
  It does NOT modify sections/header.liquid.

  COLOUR FORMAT
  -------------
  Background colours use separate RGB + opacity values so that semi-transparent
  headers work correctly (matching legacy header_color_opacity behaviour).
  Text colours are applied as solid values.
{% endcomment %}

{%- liquid
  assign normal_r = section.settings.normal_bg | color_extract: 'red'
  assign normal_g = section.settings.normal_bg | color_extract: 'green'
  assign normal_b = section.settings.normal_bg | color_extract: 'blue'
  assign normal_opacity = section.settings.normal_opacity | divided_by: 100.0

  assign scroll_r = section.settings.scroll_bg | color_extract: 'red'
  assign scroll_g = section.settings.scroll_bg | color_extract: 'green'
  assign scroll_b = section.settings.scroll_bg | color_extract: 'blue'
  assign scroll_opacity = section.settings.scroll_opacity | divided_by: 100.0

  assign hover_r = section.settings.hover_bg | color_extract: 'red'
  assign hover_g = section.settings.hover_bg | color_extract: 'green'
  assign hover_b = section.settings.hover_bg | color_extract: 'blue'
  assign hover_opacity = section.settings.hover_opacity | divided_by: 100.0
-%}

<style>
  /* ── GLDN Header State CSS custom properties ─────────────────────────── */
  :root {
    --gldn-header-normal-bg:      rgba({{ normal_r }}, {{ normal_g }}, {{ normal_b }}, {{ normal_opacity }});
    --gldn-header-normal-text:    {{ section.settings.normal_text }};

    --gldn-header-scroll-bg:      rgba({{ scroll_r }}, {{ scroll_g }}, {{ scroll_b }}, {{ scroll_opacity }});
    --gldn-header-scroll-text:    {{ section.settings.scroll_text }};

    --gldn-header-hover-bg:       rgba({{ hover_r }}, {{ hover_g }}, {{ hover_b }}, {{ hover_opacity }});
    --gldn-header-hover-text:     {{ section.settings.hover_text }};

    --gldn-header-transition:     {{ section.settings.transition_speed }}ms ease;
  }
</style>

<script src="{{ 'custom-header-state.js' | asset_url }}" defer></script>

{%- render 'custom-header-wishlist' -%}
{%- render 'custom-header-logo' -%}
{%- render 'custom-mega-menu' -%}

