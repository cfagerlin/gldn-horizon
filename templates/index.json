    "gldn_how_it_works": {
      "type": "custom-how-it-works",
      "name": "The GLDN Difference",
      "blocks": {
        "step_custom_jewelry": {
          "type": "step",
          "settings": {
            "eyebrow": "THE GLDN DIFFERENCE",
            "title": "Custom Jewelry",
            "text": "<p>Make a one-of-a-kind piece with initials, names, dates, coordinates or symbols\u2014or anything you want to hold close\u2014and we\u2019ll bring it to life in our studio using hand tools and hand-stamping techniques. The result? A meaningful piece you\u2019ll truly cherish for a lifetime.</p>",
            "image": "shopify://shop_images/Slide_1.jpg",
            "video_loop": false
          }
        },
        "step_circular_design": {
          "type": "step",
          "settings": {
            "eyebrow": "THE GLDN DIFFERENCE",
            "title": "Circular Design",
            "text": "<p>90% of the metals we use are recycled, and we either reuse our leftover metals in new pieces or send them to a refinery. Using recycled metals is one of the best ways to reduce a jewelry piece\u2019s carbon footprint, and protect biodiversity and endangered animals across the planet.</p>",
            "image": "shopify://shop_images/Slide_2.jpg",
            "video_loop": false
          }
        },
        "step_fair_sourcing": {
          "type": "step",
          "settings": {
            "eyebrow": "THE GLDN DIFFERENCE",
            "title": "Fair Sourcing",
            "text": "<p>We only work with suppliers who\u2019ve been certified by the Responsible Jewellery Council, a non-profit sustainability auditor that upholds human rights, labor standards, and environmental protection throughout the entire jewelry supply chain.</p>",
            "image": "shopify://shop_images/Slide_3.png",
            "video_loop": false
          }
        }
      },
      "block_order": [
        "step_custom_jewelry",
        "step_circular_design",
        "step_fair_sourcing"
      ],
      "settings": {
        "eyebrow": "The Process",
        "heading": "The GLDN Difference",
        "media_position": "left",
        "autoplay": false,
        "autoplay_speed": 5,
        "show_final_button": true,
        "final_button_label": "GET THE FULL STORY",
        "final_button_link": "shopify://pages/return-policies",
        "section_width": "page-width",
        "color_scheme": "scheme-2",
        "padding-block-start": 80,
        "padding-block-end": 80
      }
