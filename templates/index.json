    "gldn_home_anatomy": {
      "type": "custom-home-anatomy",
      "name": "Product Spotlights",
      "blocks": {
        "slide_toi_et_moi": {
          "type": "slide",
          "settings": {
            "eyebrow": "Aura birthstones",
            "title": "Toi et Moi Necklace",
            "text": "<p>\u201cI absolutely love this necklace. So dainty, simple and beautiful. I got it with me and my son\u2019s birthstones. Thank you!\u201d</p><p>- Angela E.</p>",
            "image": "shopify://shop_images/Toi_et_Moi.jpg",
            "features": "<p><strong>Piece</strong><br/><a href=\"/products/silver-toi-et-moi-necklace\" title=\"Silver Toi et Moi Necklace\">Toi et Moi Necklace</a></p>",
            "button_label": "SHOP AURA BIRTHSTONES",
            "button_link": "shopify://collections/aura-gemstones"
          }
        },
        "slide_aura_enamel": {
          "type": "slide",
          "settings": {
            "eyebrow": "STACKING FAVORITES",
            "title": "Aura Enamel Bead",
            "text": "<p>\u201cI love how dainty these are but they provide a little color and elevate the jewelry. Lightweight, shiny and precious. I ordered the Sage Green and it fits August beautifully.\u201d</p><p>- Sarah H.</p>",
            "image": "shopify://shop_images/Aura_Enamel_Bead.jpg",
            "features": "<p><strong>Piece</strong><br/><a href=\"/products/aura-enamel-bead\" title=\"Extra Aura Enamel Bead\">Aura Enamel Beads</a></p>",
            "button_label": "SHOP CHARMS",
            "button_link": "shopify://collections/charms"
          }
        },
        "slide_my_garden": {
          "type": "slide",
          "settings": {
            "eyebrow": "flora",
            "title": "My Garden Meuse Band",
            "text": "<p>\u201cI bought these rings to ask both my sisters to be my maid of honors. I used the flowers of each of our birth months along with our mother\u2018s birth flower and they came out absolutely beautiful!\u201d</p><p>- Kristene G.</p>",
            "image": "shopify://shop_images/My_Garden.jpg",
            "features": "<p><strong>Piece</strong><br/><a href=\"/products/my-garden-meuse-band\" title=\"My Garden Meuse Band\">My Garden Meuse Band</a></p>",
            "button_label": "THE FLORA COLLECTION",
            "button_link": "shopify://collections/flora"
          }
        }
      },
      "block_order": [
        "slide_toi_et_moi",
        "slide_aura_enamel",
        "slide_my_garden"
      ],
